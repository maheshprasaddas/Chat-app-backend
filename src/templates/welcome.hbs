<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
  <title>Welcome to KhatiUp</title>

  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:AllowPNG/>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->

  <style>
    /* Reset */
    body,
    table,
    td,
    a {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table,
    td {
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }

    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }

    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      height: 100% !important;
    }

    a[x-apple-data-detectors] {
      color: inherit !important;
      text-decoration: none !important;
      font-size: inherit !important;
      font-family: inherit !important;
      font-weight: inherit !important;
      line-height: inherit !important;
    }

    /* Gmail fix */
    u+#body a {
      color: inherit;
      text-decoration: none;
      font-size: inherit;
      font-family: inherit;
      font-weight: inherit;
      line-height: inherit;
    }

    #MessageViewBody a {
      color: inherit;
      text-decoration: none;
      font-size: inherit;
      font-family: inherit;
      font-weight: inherit;
      line-height: inherit;
    }

    /* Dark mode styles */
    @media (prefers-color-scheme: dark) {
      .dark-bg {
        background-color: #0B1120 !important;
      }

      .dark-card {
        background-color: #131D33 !important;
      }

      .dark-text {
        color: #F0F0F0 !important;
      }

      .dark-subtext {
        color: #8A9BB5 !important;
      }
    }

    /* Responsive */
    @media only screen and (max-width: 620px) {
      .container {
        width: 100% !important;
        padding: 0 16px !important;
      }

      .content-cell {
        padding: 32px 20px !important;
      }

      .hero-text {
        font-size: 24px !important;
        line-height: 32px !important;
      }
    }
  </style>
</head>

<body id="body"
  style="margin: 0; padding: 0; background-color: #EEF2F7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

  <!-- Preview text (hidden in email body, shown in inbox preview) -->
  <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">
    {{otp}} is your verification code for KhatiUp.
    &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
  </div>

  <!-- Full-width wrapper -->
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #EEF2F7;"
    class="dark-bg">
    <tr>
      <td align="center" style="padding: 40px 16px;">

        <!-- Container -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="560" class="container"
          style="max-width: 560px; width: 100%;">

          <!-- Logo / Header -->
          <tr>
            <td align="center" style="padding-bottom: 24px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td
                    style="background-color: #1B3A6B; border-radius: 50%; width: 56px; height: 56px; text-align: center; vertical-align: middle;">
                    <span style="font-size: 28px; color: #ffffff; line-height: 56px;">💬</span>
                  </td>
                </tr>
              </table>
              <p style="margin: 12px 0 0; font-size: 22px; font-weight: 700; color: #1B3A6B; letter-spacing: -0.5px;">
                KhatiUp</p>
            </td>
          </tr>

          <!-- Main Card -->
          <tr>
            <td>
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                style="background-color: #ffffff; border-radius: 16px; box-shadow: 0 2px 12px rgba(27,58,107,0.08);"
                class="dark-card">

                <!-- Navy blue accent bar -->
                <tr>
                  <td
                    style="height: 4px; background: linear-gradient(90deg, #1B3A6B, #2D5CA0); border-radius: 16px 16px 0 0; font-size: 0; line-height: 0;">
                    &nbsp;</td>
                </tr>

                <!-- Content -->
                <tr>
                  <td class="content-cell" style="padding: 48px 40px;">

                    <!-- Greeting -->
                    <h1 class="hero-text dark-text"
                      style="margin: 0 0 8px; font-size: 28px; line-height: 36px; font-weight: 700; color: #1B3A6B;">
                      Hey {{userName}} 👋
                    </h1>
                    <p class="dark-subtext"
                      style="margin: 0 0 28px; font-size: 16px; line-height: 24px; color: #5A6D85;">
                      Welcome aboard! Use the verification code below to activate your account.
                    </p>

                    <!-- OTP Verification Code Block -->
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                      style="margin-bottom: 28px;">
                      <tr>
                        <td align="center">
                          <table role="presentation" cellspacing="0" cellpadding="0" border="0"
                            style="background-color: #EDF1F8; border: 2px dashed #2D5CA0; border-radius: 12px;">
                            <tr>
                              <td style="padding: 24px 40px; text-align: center;">
                                <p
                                  style="margin: 0 0 8px; font-size: 13px; font-weight: 600; color: #5A6D85; text-transform: uppercase; letter-spacing: 1.5px;">
                                  Your Verification Code</p>
                                <p
                                  style="margin: 0; font-size: 40px; font-weight: 700; color: #1B3A6B; letter-spacing: 10px; font-family: 'Courier New', Courier, monospace;">
                                  {{otp}}</p>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>

                    <!-- Expiry notice -->
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                      style="margin-bottom: 28px;">
                      <tr>
                        <td align="center">
                          <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                            <tr>
                              <td style="width: 24px; vertical-align: middle; text-align: center;">
                                <span style="font-size: 16px;">⏱️</span>
                              </td>
                              <td style="padding-left: 6px; vertical-align: middle;">
                                <p style="margin: 0; font-size: 14px; color: #C47A20; font-weight: 600;">This code
                                  expires in 5 minutes</p>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>

                    <!-- Divider -->
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                      <tr>
                        <td style="height: 1px; background-color: #DEE4ED; font-size: 0; line-height: 0;">&nbsp;</td>
                      </tr>
                    </table>

                    <!-- Feature highlights -->
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                      style="margin-top: 28px;">
                      <tr>
                        <td style="padding-bottom: 20px;">
                          <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                            <tr>
                              <td style="width: 40px; vertical-align: top;">
                                <div
                                  style="background-color: #E4EAF4; border-radius: 10px; width: 36px; height: 36px; text-align: center; line-height: 36px; font-size: 18px;">
                                  🔒</div>
                              </td>
                              <td style="padding-left: 12px; vertical-align: top;">
                                <p class="dark-text"
                                  style="margin: 0 0 2px; font-size: 15px; font-weight: 600; color: #1B3A6B;">End-to-End
                                  Encrypted</p>
                                <p class="dark-subtext"
                                  style="margin: 0; font-size: 14px; color: #5A6D85; line-height: 20px;">Your messages
                                  are secured with industry-standard encryption.</p>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-bottom: 20px;">
                          <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                            <tr>
                              <td style="width: 40px; vertical-align: top;">
                                <div
                                  style="background-color: #E4EAF4; border-radius: 10px; width: 36px; height: 36px; text-align: center; line-height: 36px; font-size: 18px;">
                                  👥</div>
                              </td>
                              <td style="padding-left: 12px; vertical-align: top;">
                                <p class="dark-text"
                                  style="margin: 0 0 2px; font-size: 15px; font-weight: 600; color: #1B3A6B;">Group
                                  Chats</p>
                                <p class="dark-subtext"
                                  style="margin: 0; font-size: 14px; color: #5A6D85; line-height: 20px;">Create groups,
                                  share media, and stay connected with everyone.</p>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                      <tr>
                        <td>
                          <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                            <tr>
                              <td style="width: 40px; vertical-align: top;">
                                <div
                                  style="background-color: #E4EAF4; border-radius: 10px; width: 36px; height: 36px; text-align: center; line-height: 36px; font-size: 18px;">
                                  ⚡</div>
                              </td>
                              <td style="padding-left: 12px; vertical-align: top;">
                                <p class="dark-text"
                                  style="margin: 0 0 2px; font-size: 15px; font-weight: 600; color: #1B3A6B;">Real-Time
                                  Messaging</p>
                                <p class="dark-subtext"
                                  style="margin: 0; font-size: 14px; color: #5A6D85; line-height: 20px;">Lightning-fast
                                  delivery with live typing indicators and read receipts.</p>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>

                    <!-- Security notice -->
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                      style="margin-top: 28px;">
                      <tr>
                        <td
                          style="background-color: #FFF8EC; border: 1px solid #F0E0C0; border-radius: 8px; padding: 14px 16px;">
                          <p style="margin: 0; font-size: 13px; color: #8A6D2B; line-height: 18px;">
                            🛡️ <strong>Security tip:</strong> Never share this code with anyone. KhatiUp will never ask
                            for your OTP via call, SMS, or email.
                          </p>
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 28px 20px; text-align: center;">
              <p style="margin: 0 0 6px; font-size: 13px; color: #7A8A9E; line-height: 18px;">
                You received this email because you registered on KhatiUp.
              </p>
              <p style="margin: 0; font-size: 12px; color: #95A3B5; line-height: 18px;">
                © {{currentYear}} KhatiUp. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
        <!-- /Container -->

      </td>
    </tr>
  </table>

</body>

</html>